{
  "name": "auradesk",
  "productName": "AuraDesk",
  "version": "1.0.0",
  "description": "Zero-friction, open-source AI desktop workspace with visual superpowers, plain-English safety guardrails, local memory, and live canvas.",
  "main": "dist-electron/main.cjs",
  "author": "AuraDesk Open Source Contributors",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev:renderer": "vite",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:icons && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "preview:desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.2.11",
    "@ai-sdk/google": "^1.2.18",
    "@ai-sdk/openai": "^1.3.22",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^4.3.16",
    "autoprefixer": "^10.4.20",
    "dompurify": "^3.2.4",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.7",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "unpdf": "^0.12.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
